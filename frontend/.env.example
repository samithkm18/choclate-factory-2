# Mani's Chocolate Factory - Frontend Environment Variables
# Copy to .env or set in Vercel Project Settings > Environment Variables

# Backend API URL (for production, e.g., https://your-backend.onrender.com)
# When omitted, defaults to http://localhost:5000
VITE_API_URL=http://localhost:5000

# Backend WebSocket URL (for production, e.g., wss://your-backend.onrender.com)
# When omitted, automatically derived from VITE_API_URL (http -> ws, https -> wss)
# VITE_WS_URL=ws://localhost:5000
